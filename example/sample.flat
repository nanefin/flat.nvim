## ==========================================
## sample.flat - メインサンプルファイル
## ==========================================

#!import: ./common_base.flat

#!section: イントロダクション
> テストの目的
flat (v3) のインポート・参照機能の動作を確認します。

> 要素の展開
ベース情報の展開:
#$base_info;

ベースサーバーの展開:
#$base_servers;

#!block: app_config
env: production
port: 8080
target_host: #$base_servers;

#!section: デプロイ手順
> 実行手順
共通の踏み台サーバーを経由してデプロイを実行します。

> 検証
参照先の確認:
#$base_servers;

パス参照のテスト:
#$./common_base.flat;
